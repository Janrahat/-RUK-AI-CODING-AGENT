# ---------------------------------------------------------------------------
# RUK AI backend configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- app -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list, or * for development only.
CORS_ORIGINS=*

# --- database --------------------------------------------------------------
# Zero-setup default (SQLite). For production use PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://rukai:password@localhost:5432/rukai
DATABASE_URL=sqlite+aiosqlite:///./rukai.db
DB_ECHO=false

# --- auth ------------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=30

# Fernet key used to encrypt stored provider API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
AI_RATE_LIMIT_PER_MINUTE=20

# --- AI providers (server-side fallback keys) ------------------------------
# Users may instead store their own keys in the app (Profile -> API Keys).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai

# Required for video generation (text-to-video / image-to-video).
FAL_API_KEY=
FAL_BASE_URL=https://queue.fal.run

# --- google sign-in --------------------------------------------------------
# The OAuth client id of the Android app; used to verify ID token audience.
GOOGLE_CLIENT_ID=

# --- limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
REQUEST_TIMEOUT_SECONDS=120
FREE_DAILY_MESSAGES=40
PRO_DAILY_MESSAGES=2000

# --- code execution sandbox ------------------------------------------------
CODE_EXEC_ENABLED=true
CODE_EXEC_TIMEOUT_SECONDS=10
CODE_EXEC_MAX_OUTPUT_BYTES=65536
